msgstr "Reklámok megjelenésének letiltása."

msgid "Specify the format to display filenames in the list."
msgstr "A fájlnevek megjelenítési formátumának megváltoztatása"

msgid "Drive letter + Partial (path + Filename)"
msgstr "Lemez betűjele + útvonal + fájlnév"

