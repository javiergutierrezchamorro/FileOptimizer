msgid "FileOptimizer"
msgstr "FileOptimizer"

msgid "&About..."
msgstr "バージョン情報(&A)..."

msgid "Open the about window with internal and legal information"
msgstr "内部情報と法的情報を含むバージョン情報ウィンドウを開きます。"

msgid "-"
msgstr "-"

msgid "Donate..."
msgstr "寄付..."

msgid "Support the development by easily and securely money donations"
msgstr "簡単かつ安全に寄付をして開発を支援しましょう。"

msgid "&Information..."
msgstr "情報(&I)..."

msgid "Open information window with the list of currently supported file formats"
msgstr "現在サポートされているファイル形式の一覧を含む情報ウィンドウを開きます。"

msgid "Help topics..."
msgstr "ヘルプのトピック..."

msgid "Open help topics"
msgstr "ヘルプのトピックを開く"

msgid "&Help"
msgstr "ヘルプ(&H)"

msgid "&Options..."
msgstr "オプション(&O)..."

msgid "Open configuration options window"
msgstr "設定オプションウィンドウを開きます。"

msgid "&Stop"
msgstr "停止(&S)"

msgid "Stop in-progress optimizations"
msgstr "進行中の最適化を停止します。"

msgid "&Optimize all files"
msgstr "すべてのファイルを最適化する(&O)"

msgid "Optimize files in the optimization list"
msgstr "一覧にあるファイルを最適化します。"

msgid "&Optimize"
msgstr "最適化(&O)"

msgid "E&xit..."
msgstr "終了(&X)..."

msgid "Exit the program"
msgstr "プログラムを終了します"

msgid "Open &containing folder..."
msgstr "選択した項目を含むフォルダーを開く(&C)..."

msgid "Open folder containing selected item"
msgstr "選択した項目を含むフォルダーを開きます。"

msgid "&Open selected file"
msgstr "選択したファイルを開く(&O)"

msgid "Open selected file with the associated program"
msgstr "選択したファイルを関連付けられたプログラムで開きます。"

msgid "&Clear all files"
msgstr "すべてのファイルを消去(&C)"

msgid "Empty all files in the optimization list"
msgstr "一覧のすべてのファイルを空にします。"

msgid "&Remove selected files"
msgstr "選択したファイルを消去(&R)"

msgid "Remove selected files from the optimization list"
msgstr "選択したファイルを一覧から消去します。"

msgid "A&dd folder..."
msgstr "フォルダーを追加(&D)..."

msgid "Add folder contents recursively from your computer to the optimization list"
msgstr "コンピューターからフォルダーの内容を再帰的に一覧へ追加します。"

msgid "&Add files..."
msgstr "ファイルを追加(&A)..."

msgid "Add files from your computer to the optimization list"
msgstr "コンピューターからファイルを一覧に追加します。"

msgid "&File"
msgstr "ファイル(&F)"

msgid "© Copyright 2012-2019 by Javier Gutiérrez Chamorro (Guti)"
msgstr "© Copyright 2012-2019 by Javier Gutiérrez Chamorro (Guti)"

msgid "https://nikkhokkho.sourceforge.io/static.php?page=FileOptimizer"
msgstr "https://nikkhokkho.sourceforge.io/static.php?page=FileOptimizer"

msgid "Drag on the list below files you want to optimize, and when ready, click on the right button context menu to proceed. All processed files are copied to Recycle Bin, so you can easily restore them. You can disable moving to Recycle Bin if you like. Double click an item to preview it."
msgstr "最適化したいファイルを一覧にドラッグして、準備ができたら右ボタンで表示されるコンテンツメニューをクリックで続行します。\n処理済みのファイルは、すべてごみ箱に移動されるため簡単に復元することができます。\n必要に応じて、ごみ箱への移動を無効にすることもできます。項目をダブルクリックでプレビューが表示されます。"

msgid "File"
msgstr "ファイル"

msgid "Extension (Type)"
msgstr "拡張子 (タイプ)"

msgid "Original size"
msgstr "オリジナルのサイズ"

msgid "Optimized size"
msgstr "最適化後のサイズ"

msgid "Status"
msgstr "ステータス"

msgid "Optimization is still running. Do you want to stop and exit %s?"
msgstr "最適化は実行中です。停止して %s を終了しますか？"

msgid "About"
msgstr "バージョン情報"

msgid "&Close"
msgstr "閉じる(&C)"

msgid "and %s file formats among many others."
msgstr "と %s ファイル形式などその他多数。"

msgid " is an advanced file optimizer featuring a lossless (no quality loss) file size reduction that supports: "
msgstr " は、ロスレス (品質の低下がなし) のファイルサイズ削減を特徴とする高度なファイル最適化であり、以下をサポートします。"

