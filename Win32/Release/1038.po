msgstr "A főablakok mindig mindennek a tetején legyenek."

msgid "&Show toolbar"
msgstr "Eszköztár megjelenítése"

msgid "Show icons toolbar on main window"
msgstr "Ikontár megjelenítése a fő ablakban"

msgid "If you have already donated to support FileOptimizer development, enter here the email address or name you used"
msgstr "Ha támogattad a FileOptimizer fejlesztését, írd be ide az email címedet vagy a nevet, amit használtál"

msgid "&Language"
msgstr "Nyelv"

msgid "&Filename format"
msgstr "Fájlnév formátuma"

msgid "&Donator"
msgstr "Adományozó"

msgid "&Appearance"
msgstr "Megjelenés"

msgid "&Allow multiple instances"
msgstr "Több példány engedélyezése"

msgid "Allow having more than one FileOptimizer instance. If not, a warning will appear."
msgstr "Engedélyezze több FileOptimizer példány futását egyidőben. Ha ez ki van kapcsolva, egy figyelmeztetés jelenik meg ha több példányt indítasz el."

msgid "&Enable cache"
msgstr "Gyorsítótár engedélyezése"

msgid "Enable cache of already optimized files to automatically skip them."
msgstr "Gyorsítótárazza a már optimalizát fájlokat, hogy legközelebb azokat átugorja."

msgid "If specified, number of trial iterations in all Leanify executions will use this value. If not, iterations are calculated depending on the Optimization level."
msgstr "Ha ide beírsz egy számot, a Leanify annyi iterációt fog végrehajtani. Ha nem, az iterációk az Optimalizációs szint alapján lesznek beállítva."

msgid "&Allow duplicates"
msgstr "Duplikátumok engedélyezése"

msgid "Allow adding same file more than once. If enabled, adding to the grid will be much faster, specially on very large grids."
msgstr "Engedélyezze a egy fájl többszöri hozzáadását. Ha ez be van kapcsolva, a rács hozzáadása sokkal gyorsabb lesz, különösen nagyon nagy rácsoké."

msgid "&Clear when complete"
msgstr "Kiűrítés, ha végzett"

msgid "Automatically clear file list when optimization is completed."
msgstr "Automatikusan kiűríti a fájlok listáját az optimalizáció végeztével"

msgid "&Shutdown when done"
msgstr "Kikapcsolás, ha kész"

msgid "Shutdown computer when optimization completes."
msgstr "Kikapcsolja a számítógépet az optimalizáció végeztekor."

msgid "&Beep when done"
msgstr "Pittyegés ha kész"

msgid "Beep the speaker when optimization completes."
msgstr "Pittyegjen, ha kész. Nem minden rendszeren működik."

msgid "Allow excluding execution of certain plugins. It is case insensitive, and allows more than one item to be specified by using semicolon as separator."
msgstr "Egyes pluginok végrehajtásának megakadályozásának engedélyezése. Nem érzékeny a kis- és nagybetűkre, több elemet is hozzá lehet adni, amiket ; -vel kell elválasztani."

msgid "&Leanify iterations"
msgstr "Leanify iterációk"

msgid "&Disable plugin mask"
msgstr "Plugin maszk kikapcsolása"

msgid "General &2"
msgstr "Alapbeállítások 2"

msgid "If not empty specified directory will be used for temporary storage instead of system's %TEMP%."
msgstr "Ha ez nem üres, a beleírt mappa lesz használva átmeneti mappaként, a rendszer alapértelmezett TEMP mappája helyett"

msgid "D&o not create backups"
msgstr "Ne készítsen biztonsági mentést"

msgid "When checked original files will not be backed up in the current folder as a .BAK files."
msgstr "Ha ez be van kapcsolva, nem készülnek a fájlok mappáiba .BAK kiterjesztésű másolatok."

msgid "If not empty, only files containing this mask (substring) on name or path will be included from optimization. You can use semicolon to specify more than one substring being included."
msgstr "Ha ez nem üres, csak azok a fájlok lesznek optimalizálva, amelyek tartalmazzák ezt a maszkot (subtringet) a nevükben vagy útvonalukban. Használd a ;-t, ha több ilyen substringet szeretnél hozzáadni."

msgid "Files containing this mask (substring) on name or path will be excluded from optimization. You can use semicolon (;) to specify more than one substring being excluded."
msgstr "A fájlok, amely ezt a maszkot (substringet) vagy nevet vagy útvonalat tartalmazzák, nem lesznek figyelembe véve az optimalizációkor. Használd a ;-t, ha több ilyen substringet szeretnél hozzáadni."

msgid "&Do not use recycle bin"
msgstr "Ne használja a Lomtárat"

msgid "When checked original files will not be backed up in the system trashcan."
msgstr "Amikor ez be van kapcsolva, a fájlok nem lesznek bemásolva a rendszer Lomtárába."

msgid "Debugging level to output on program log."
msgstr "Hibakeresési szint, ami a program naplójába írásra kerül."

